{
  "entities": {
    "profiles": {
      "title": "UserProfile",
      "description": "User profile information and settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "institution": { "type": "string" },
        "level": { "type": "string" },
        "age": { "type": "number" },
        "onboarded": { "type": "boolean" },
        "tutorial_seen": { "type": "boolean" },
        "is_pro": { "type": "boolean" },
        "tier": { "type": "string" },
        "notifications": { "type": "object" }
      },
      "required": ["userId", "email"]
    },
    "courses": {
      "title": "Course",
      "description": "User courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "difficulty": { "type": "string" },
        "credits": { "type": "number" }
      },
      "required": ["id", "userId", "code"]
    },
    "study_sessions": {
      "title": "StudySession",
      "description": "Scheduled study sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "day": { "type": "string" },
        "duration": { "type": "number" },
        "mode": { "type": "string" }
      },
      "required": ["id", "userId", "courseId"]
    },
    "study_hubs": {
      "title": "StudyHub",
      "description": "Study materials and AI content for courses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "summary": { "type": "string" },
        "flashcards": { "type": "array" },
        "quizzes": { "type": "array" },
        "podcastUrl": { "type": "string" },
        "transcript": { "type": "string" }
      },
      "required": ["userId", "courseId"]
    },
    "study_groups": {
      "title": "StudyGroup",
      "description": "Study groups and circles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "inviteCode": { "type": "string" },
        "visibility": { "type": "string" },
        "members": { "type": "array" },
        "messages": { "type": "array" },
        "sharedMaterials": { "type": "array" }
      },
      "required": ["id", "name"]
    },
    "admins": {
      "title": "AdminUser",
      "description": "Administrator account records and roles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "admin_logs": {
      "title": "AdminLog",
      "description": "Server-side audit log for administrative actions and security events",
      "type": "object",
      "properties": {
        "event": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["event", "status", "timestamp"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "profiles",
      "description": "User profiles collection"
    },
    "/courses/{courseId}": {
      "schema": "courses",
      "description": "Courses collection"
    },
    "/study_sessions/{sessionId}": {
      "schema": "study_sessions",
      "description": "Study sessions collection"
    },
    "/study_hubs/{hubId}": {
      "schema": "study_hubs",
      "description": "Study hubs collection"
    },
    "/study_groups/{groupId}": {
      "schema": "study_groups",
      "description": "Study groups collection"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Admin accounts collection"
    },
    "/admin_logs/{logId}": {
      "schema": "admin_logs",
      "description": "Server-side admin audit logs"
    }
  }
}
