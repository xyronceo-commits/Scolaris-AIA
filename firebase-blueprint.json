{
  "entities": {
    "profiles": {
      "title": "UserProfile",
      "description": "User profile information and settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "institution": { "type": "string" },
        "level": { "type": "string" },
        "age": { "type": "number" },
        "onboarded": { "type": "boolean" },
        "tutorial_seen": { "type": "boolean" },
        "is_pro": { "type": "boolean" },
        "tier": { "type": "string" },
        "notifications": { "type": "object" }
      },
      "required": ["userId", "email"]
    },
    "courses": {
      "title": "Course",
      "description": "User courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "difficulty": { "type": "string" },
        "credits": { "type": "number" }
      },
      "required": ["id", "userId", "code"]
    },
    "study_sessions": {
      "title": "StudySession",
      "description": "Scheduled study sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "day": { "type": "string" },
        "duration": { "type": "number" },
        "mode": { "type": "string" }
      },
      "required": ["id", "userId", "courseId"]
    },
    "study_hubs": {
      "title": "StudyHub",
      "description": "Study materials and AI content for courses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "summary": { "type": "string" },
        "flashcards": { "type": "array" },
        "quizzes": { "type": "array" },
        "podcastUrl": { "type": "string" },
        "transcript": { "type": "string" }
      },
      "required": ["userId", "courseId"]
    },
    "study_groups": {
      "title": "StudyGroup",
      "description": "Study groups and study communities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "course": { "type": "string" },
        "type": { "type": "string" },
        "visibility": { "type": "string" },
        "inviteCode": { "type": "string" },
        "department": { "type": "string" },
        "level": { "type": "string" },
        "university": { "type": "string" },
        "academicSession": { "type": "string" },
        "groupImage": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array" },
        "messages": { "type": "array" },
        "sharedMaterials": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "course", "ownerId"]
    },
    "group_materials": {
      "title": "GroupMaterial",
      "description": "Shared learning materials uploaded to specific study group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "storagePath": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "content": { "type": "string" }
      },
      "required": ["id", "groupId", "fileName", "uploadedBy", "storagePath"]
    },
    "group_discussions": {
      "title": "GroupDiscussion",
      "description": "Academic forum and discussion posts in a study group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "attachments": { "type": "array" },
        "replies": { "type": "array" }
      },
      "required": ["id", "groupId", "authorId", "content"]
    },
    "group_activity": {
      "title": "GroupActivity",
      "description": "Chronological audit log of activity within a study group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "actorName": { "type": "string" },
        "actorId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "groupId", "type", "title"]
    },
    "admins": {
      "title": "AdminUser",
      "description": "Administrator account records and roles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "admin_logs": {
      "title": "AdminLog",
      "description": "Server-side audit log for administrative actions and security events",
      "type": "object",
      "properties": {
        "event": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["event", "status", "timestamp"]
    },
    "user_files": {
      "title": "UserFile",
      "description": "Uploaded course materials and files isolated by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "storagePath": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "courseCode": { "type": "string" },
        "courseTitle": { "type": "string" }
      },
      "required": ["id", "userId", "fileName", "storagePath"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "profiles",
      "description": "User profiles collection"
    },
    "/courses/{courseId}": {
      "schema": "courses",
      "description": "Courses collection"
    },
    "/user_files/{fileId}": {
      "schema": "user_files",
      "description": "User files collection isolated by user"
    },
    "/study_sessions/{sessionId}": {
      "schema": "study_sessions",
      "description": "Study sessions collection"
    },
    "/study_hubs/{hubId}": {
      "schema": "study_hubs",
      "description": "Study hubs collection"
    },
    "/study_groups/{groupId}": {
      "schema": "study_groups",
      "description": "Study groups collection"
    },
    "/study_groups/{groupId}/materials/{materialId}": {
      "schema": "group_materials",
      "description": "Group materials subcollection"
    },
    "/study_groups/{groupId}/discussions/{discussionId}": {
      "schema": "group_discussions",
      "description": "Group discussions subcollection"
    },
    "/study_groups/{groupId}/activity/{activityId}": {
      "schema": "group_activity",
      "description": "Group activity feed subcollection"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Admin accounts collection"
    },
    "/admin_logs/{logId}": {
      "schema": "admin_logs",
      "description": "Server-side admin audit logs"
    }
  }
}
