# ---- Supabase (browser-safe values; exposed to the client by Vite) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Supabase (server only: never prefix with VITE_) ----
# Needed for the admin dashboard and audit logs. Dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
# Optional if VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are already set
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Supabase Storage S3 (shared library uploads via /api/s3/*) ----
# Dashboard > Storage > S3 Connection > create access keys
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=scolaris-library
# Optional overrides (defaults derive from the project URL)
# SUPABASE_S3_ENDPOINT=
# SUPABASE_S3_REGION=eu-west-2

# ---- AI providers ----
SCOLARIS_AI_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Admin portal ----
ADMIN_PASSWORD=
