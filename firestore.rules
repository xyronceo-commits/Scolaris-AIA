rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins Collection - strictly protected, only readable by verified admins, writable only via server
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin Logs Collection - audit logs accessible only to authenticated admins, write restricted to server
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User Profiles
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // User Courses
    match /courses/{courseId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // User Isolated Files & Materials
    match /user_files/{fileId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Scheduled Study Sessions
    match /study_sessions/{sessionId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Study Hubs
    match /study_hubs/{hubId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Study Groups & Subcollections Security Isolation
    match /study_groups/{groupId} {
      function isGroupMember(groupData) {
        return groupData.members != null && (
          request.auth.uid in groupData.members ||
          groupData.ownerId == request.auth.uid
        );
      }

      function isJoinWrite() {
        return request.resource.data.members != null &&
          request.auth.uid in request.resource.data.members &&
          (
            resource.data.members == null ||
            request.resource.data.members.hasAll(resource.data.members)
          );
      }

      allow read: if isSignedIn(); // Allow discovery of general groups list for search
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isGroupMember(resource.data) || isJoinWrite() || isAdmin());
      allow delete: if isSignedIn() && (isGroupMember(resource.data) || isAdmin());

      // Materials subcollection isolation
      match /materials/{materialId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
      }

      // Discussions subcollection isolation
      match /discussions/{discussionId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
      }

      // Activity subcollection isolation
      match /activity/{activityId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    // Global Catch-all: Deny all unhandled operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
